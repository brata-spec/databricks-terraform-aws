aws_region           = "us-east-1"
name_prefix          = "dbx"
github_org           = "brata-spec"
github_repo          = "terraform-platform"
environments         = ["dev", "prod"]
create_oidc_provider = true # false if the account already has the GitHub OIDC provider

# If `gh api repos/<org>/<repo>/actions/oidc/customization/sub` shows
# "use_immutable_subject": true, copy the two numbers from sub_claim_prefix:
#   repo:<org>@<owner_id>/terraform-platform@<repo_id>
github_owner_id = "<owner_id>"
github_repo_id  = "<repo_id>"
